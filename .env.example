# Echo Discord Bot - Environment Variables Template
# Kopiere diese Datei zu .env und fülle deine eigenen Werte ein.
# Wichtig: .env sollte nicht ins Git-Repository committed werden.

# Discord Bot Token - ERFORDERLICH
DISCORD_TOKEN=your_discord_token_here

# Groq API Key - OPTIONAL, aber wichtig für KI-Chatbot-Funktionen
GROQ_API_KEY=your_groq_api_key_here
